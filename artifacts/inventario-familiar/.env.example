# Frontend (artifacts/inventario-familiar)
# Copia este archivo como `.env` y ajusta los valores.

# Puerto del dev server y ruta base
PORT=23322
BASE_PATH=/

# Proxy del API en dev (apunta al API server local)
API_PROXY_TARGET=http://localhost:8080

# URL del proyecto Supabase (local: supabase start -> API URL)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Anon key del proyecto Supabase (supabase start -> anon key)
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
