# API Server (artifacts/api-server)
# Copia este archivo como `.env` y ajusta los valores.

# Puerto HTTP del API
PORT=8080

# Postgres de Supabase local (supabase start). En cloud: connection string del proyecto.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# URL del proyecto Supabase (local: supabase start -> API URL)
SUPABASE_URL=http://127.0.0.1:54321

# Solo necesario si verificaras tokens con el secret legacy HS256.
# En local con JWKS (por defecto) no se requiere.
#SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
